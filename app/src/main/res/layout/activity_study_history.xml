<?xml version="1.0" encoding="utf-8" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Study History"
            android:textColor="#24213A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHistoryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loading study history..."
            android:textColor="#6F6B80"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRefreshHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh history"
            android:textAllCaps="false"
            android:backgroundTint="#E8E4FA"
            android:textColor="#33266F" />

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnBackHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Back"
            android:textAllCaps="false"
            android:backgroundTint="#6554C0"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>